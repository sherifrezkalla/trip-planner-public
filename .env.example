# LLM
LLM_PROVIDER=ollama            # ollama | anthropic (which model is PRIMARY)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5.2:cloud
OLLAMA_CHAT_MODEL=deepseek-v4-flash:cloud
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google (server key: Places API (New); browser key: Maps JavaScript API, referrer-restricted)
GOOGLE_MAPS_API_KEY=
# Dedicated server-only key. Enable Google Routes API billing and quotas separately.
# Optional: leave empty until supplied; route research returns unavailable.
# Never substitute GOOGLE_MAPS_API_KEY for this key.
GOOGLE_ROUTES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Public canonical app URL; recommended explicit configuration, not a secret.
# Example only: https://your-trip-planner.example
# Leave empty on Vercel to use its system VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Trip-agent gateway (server-only; do not use NEXT_PUBLIC_ prefixes for secrets)
# Generate a fresh stable deployment secret, shared by every function instance.
# Do not rotate this pepper as part of ordinary connector credential rotation.
TRIP_AGENT_IDENTITY_PEPPER=
# Comma-separated deployed hostnames; no schemes, paths, or ports.
# Example only: your-trip-planner.example
# For isolated local testing only, explicitly allow localhost; never add it in production.
TRIP_AGENT_ALLOWED_HOSTS=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
